<% layout("./common/boilerplate") %>
<main class="spots">
	<section class="spots__header">
		<div class="spots__map" id="clusterMap"></div>
		<div id="scrollAfterSearch" class="heading-primary">All Spots</div>
		<form class="form" method="get" action="/spots#scrollAfterSearch">
			<input
				class="form__input"
				type="search"
                name="search"
				placeholder="Filter by spot name or location"
                value="<%= search || '' %>"
                aria-label="Search"
            />
			<button type="submit" class="btn">Search</button>
		</form>
        <% if(search && spots.length > 0) { %>
            <div class="spots__search-text">Showing <%= spots.length %> search result(s) for <span>'<%= search %>'</span>...</div>
        <% } %>
	</section>
	<section class="spots__list">
		<% for(let spot of spots) { %>
		<a
			style="
				background: linear-gradient(
						180deg,
						rgba(0, 0, 0, 0.04) 0%,
						rgba(0, 0, 0, 0.4) 100%
					),
					url('<%= (spot.images.length > 0) ? spot.images[0].slide : "/assets/img/blank-image.png" %>')
						lightgray 50% / cover no-repeat;
			"
			class="spots__item"
			href="/spots/<%= spot._id %>">
			<div class="spots__info">
				<div>
					<div class="spots__name"><%= spot.name %></div>
					<div class="spots__place"><%= spot.location %></div>
				</div>
				<div>
					<img
						class="spots__arrow-icon"
						src="/assets/icons/arrow-forward.svg"
						alt="forward arrow icon" />
				</div>
			</div>
		</a>
		<% } %>
        <% if(search && spots.length === 0) { %>
            <div class="spots__empty">
                <img src="/assets/no-matches.png" alt="Sad face">
                <div class="spots__empty-main">
                    <p class="heading-primary heading-primary--small">No spots matching <span>'<%= search %>'</span></p>
                    <div class="spots__empty-links">
                        <a href="/spots/new" class="link">Add New Spot</a>
                        <a href="/spots" class="link">Clear Filters</a>
                    </div>
                </div>
            </div>
        <% } %>
	</section>
     <% if(search && spots.length > 0) { %>
        <div class="spots__search-end">
            <div>
                <div class="line"></div>
                <span>You've reached the end of the list.</span>
                <div class="line"></div>
            </div>
            <a href="/spots" class="btn">Clear Filters</a>
        </div>
    <% } %>
</main>

<script>
	const mapToken = "<%- process.env.MAPBOX_TOKEN %>";
	const spots = {features: <%- JSON.stringify(spots) %>}
</script>

<script src="/js/clusterMap.js"></script>
